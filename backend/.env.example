# Copy to .env and fill in. Never commit .env.
GOLDAPI_KEY=your-goldapi-key-here

# Free plan = 100 requests/month. Each refresh uses 2 (gold + silver).
# Keep a safety margin below the real limit.
MONTHLY_REQUEST_BUDGET=90

# Hours (IST) when the scheduler refreshes. "10" = once a day = ~60 requests/month.
# "10,17" would use ~120/month and exceed the free plan.
REFRESH_HOURS=10

ADMIN_TOKEN=change-me-to-a-long-random-string

# Import duty % in force from each date (YYYY-MM-DD:percent, comma separated).
# The cards use today's rate; the history chart uses each day's rate.
# When the government changes the duty, add a new entry at the end, e.g. ...,2027-02-01:12
# Duty = basic customs duty + AIDC cess. IGST is the separate GST_PCT below.
# 6 = rate before the May 2026 hike, 15 = rate from 13 May 2026. Verify against an official source.
DUTY_SCHEDULE=2000-01-01:6,2026-05-13:15

# Only used if DUTY_SCHEDULE is empty (one flat rate for all dates).
IMPORT_DUTY_PCT=0
GST_PCT=3

CORS_ORIGINS=http://localhost:5173
DB_PATH=prices.db
STALE_AFTER_HOURS=30
